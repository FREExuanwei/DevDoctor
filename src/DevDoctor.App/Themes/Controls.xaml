<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:DevDoctor.Core;assembly=DevDoctor.Core"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:ui="clr-namespace:DevDoctor.App.Services">
  <ui:PageVisibilityConverter x:Key="PageVisibility" /><ui:PageCheckedConverter x:Key="PageChecked" />
  <ui:ChoiceSelectionConverter x:Key="ChoiceSelected" />
  <ui:BoolVisibilityConverter x:Key="BoolVisibility" /><ui:CardWidthConverter x:Key="CardWidth" />
  <ui:AppearancePreviewWidthConverter x:Key="AppearancePreviewWidth" />
  <DrawingImage x:Key="AppIcon"><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#75BFFF" Geometry="M 7,0 L 25,0 Q 32,0 32,7 L 32,25 Q 32,32 25,32 L 7,32 Q 0,32 0,25 L 0,7 Q 0,0 7,0 Z" />
    <GeometryDrawing Geometry="M 4,16 L 9,16 L 12,7 L 17,26 L 21,12 L 24,16 L 28,16"><GeometryDrawing.Pen><Pen Brush="#071A35" Thickness="2.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="{DynamicResource BodyLineHeight}" /></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="{DynamicResource BodyLineHeight}" /></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
  <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" RadiusX="7" RadiusY="7" Margin="-3" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" /><Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86" /><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.66" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Padding" Value="4,6" /></Style>
  <Style x:Key="NavButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,3" /><Setter Property="Padding" Value="{DynamicResource NavPadding}" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="NavRoot" CornerRadius="{DynamicResource ControlRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBackground}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavRoot" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" /><Setter Property="Padding" Value="{DynamicResource CardPadding}" /><Setter Property="Effect" Value="{DynamicResource CardShadow}" /></Style>
  <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Background" Value="{DynamicResource HeroBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource HeroRadius}" /><Setter Property="Padding" Value="{DynamicResource HeroPadding}" /><Setter Property="ClipToBounds" Value="True" /></Style>
  <Style x:Key="HeroDecoration" TargetType="Path"><Setter Property="Data" Value="{DynamicResource HeroDecorationGeometry}" /><Setter Property="Fill" Value="{DynamicResource HeroDecorationBrush}" /><Setter Property="Width" Value="240" /><Setter Property="MaxHeight" Value="190" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
  <Style x:Key="ToolCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Padding" Value="{DynamicResource ToolCardPadding}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /><Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="ThemePreviewCard" TargetType="Button" BasedOn="{StaticResource ToolCard}">
    <Setter Property="Padding" Value="9" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Margin" Value="0,0,12,12" />
    <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource AccentBackground}" /></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="{DynamicResource SmallRadius}" /><Setter Property="Padding" Value="8,3" /><Setter Property="Background" Value="{DynamicResource UnknownBackground}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Normal}"><Setter Property="Background" Value="{DynamicResource SuccessBackground}" /></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Warning}"><Setter Property="Background" Value="{DynamicResource WarningBackground}" /></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Error}"><Setter Property="Background" Value="{DynamicResource ErrorBackground}" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="StatusLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{DynamicResource UnknownBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Normal}"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Warning}"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Error}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="StatusIcon" TargetType="TextBlock" BasedOn="{StaticResource StatusLabel}">
    <Setter Property="Text" Value="·" /><Setter Property="Margin" Value="0,0,4,0" />
    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Normal}"><Setter Property="Text" Value="✓" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Warning}"><Setter Property="Text" Value="△" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Error}"><Setter Property="Text" Value="×" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.Unknown}"><Setter Property="Text" Value="?" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="{x:Static core:DiagnosticStatus.NotInstalled}"><Setter Property="Text" Value="−" /></DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="StatusTemplate"><Border Style="{StaticResource StatusBadge}" ui:UiEffects.FadeOnChange="{Binding StatusText}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource StatusIcon}" /><TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLabel}" /></StackPanel></Border></DataTemplate>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="EvidenceBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="IsReadOnly" Value="True" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Background" Value="{DynamicResource CodeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Microsoft YaHei UI" /><Setter Property="FontSize" Value="12" />
    <Setter Property="MaxHeight" Value="200" /><Setter Property="VerticalScrollBarVisibility" Value="Auto" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" /><Setter Property="MinWidth" Value="180" /><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"><Grid><ContentPresenter /><TextBlock Text="⌄" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" /></Grid></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Margin="{DynamicResource SelectionPadding}" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" />
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="0,4,0,0"><ScrollViewer MaxHeight="300"><ItemsPresenter /></ScrollViewer></Border></Popup>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentBackground}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentBackground}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="14" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="8,6" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="CheckBorder" Width="18" Height="18" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource FaintBrush}" BorderThickness="1" CornerRadius="{DynamicResource SmallRadius}" VerticalAlignment="Center"><TextBlock x:Name="CheckMark" Text="✓" Foreground="{DynamicResource PrimaryForeground}" FontSize="13" LineHeight="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" /></Border><ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" /></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource PrimaryBackground}" /><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBackground}" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="CheckMark" Property="Text" Value="−" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /><Setter TargetName="CheckMark" Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Padding" Value="10,7" /><Setter Property="MaxWidth" Value="380" /></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ListRow" Background="Transparent" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ListRow" Property="Background" Value="{DynamicResource AccentBackground}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListRow" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource RaisedBrush}" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="MinRowHeight" Value="{DynamicResource ControlMinHeight}" /></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource HeaderBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" /></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger></Style.Triggers></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="5" /><Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource BorderBrush}" CornerRadius="4" Margin="2,1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      </Track>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CalendarDay" TargetType="primitives:CalendarDayButton">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="4,2" /><Setter Property="FontSize" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarDayButton"><Border x:Name="Day" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers>
      <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}" /></Trigger>
      <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryBackground}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
      <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value=".35" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35" /></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CalendarMonth" TargetType="primitives:CalendarButton" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="MinWidth" Value="56" /><Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" /><Setter Property="Padding" Value="6,4" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    <Style.Triggers><Trigger Property="HasSelectedDays" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBackground}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="CalendarItem" TargetType="primitives:CalendarItem">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarItem">
      <ControlTemplate.Resources><DataTemplate x:Key="DayTitleTemplate"><TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="3,5" HorizontalAlignment="Center" /></DataTemplate></ControlTemplate.Resources>
      <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}" Padding="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="‹" Width="30" MinHeight="30" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False" AutomationProperties.Name="上个月或上一年" />
          <Button x:Name="PART_HeaderButton" Grid.Column="1" MinHeight="30" Padding="5,2" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" HorizontalContentAlignment="Center" Focusable="False" />
          <Button x:Name="PART_NextButton" Grid.Column="2" Content="›" Width="30" MinHeight="30" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False" AutomationProperties.Name="下个月或下一年" />
          <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          </Grid>
          <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Hidden" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          </Grid>
          <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" Grid.ColumnSpan="3" Background="{DynamicResource RaisedBrush}" Opacity=".5" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ThemedCalendar" TargetType="Calendar">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarItem}" /><Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDay}" /><Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarMonth}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><StackPanel x:Name="PART_Root"><primitives:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" /></StackPanel></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Calendar" BasedOn="{StaticResource ThemedCalendar}" />
  <Style x:Key="DateInput" TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
  <Style TargetType="DatePicker">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" /><Setter Property="CalendarStyle" Value="{StaticResource ThemedCalendar}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Border x:Name="DateBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"><Grid x:Name="PART_Root"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><primitives:DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource DateInput}" Foreground="{TemplateBinding Foreground}" VerticalContentAlignment="Center" /><Button x:Name="PART_Button" Grid.Column="1" Width="30" Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" Focusable="False" AutomationProperties.Name="打开日历"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" /></Button><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}" AllowsTransparency="True" StaysOpen="False" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DateBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="FindingDetails">
    <StackPanel>
      <WrapPanel Margin="0,12,0,4"><Border Background="{DynamicResource AccentBackground}" CornerRadius="{DynamicResource SmallRadius}" Padding="7,3" Margin="0,0,8,4"><TextBlock Text="{Binding Guide.ConfidenceText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /></Border><TextBlock Text="{Binding Guide.PriorityText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" /></WrapPanel>
      <TextBlock Text="先理解这个问题" FontWeight="SemiBold" Margin="0,9,0,5" />
      <TextBlock Text="{Binding Guide.BeginnerNote}" Style="{StaticResource MutedText}" />
      <TextBlock Text="影响与判断范围" FontWeight="SemiBold" Margin="0,9,0,5" />
      <TextBlock Text="{Binding Guide.Impact}" Style="{StaticResource MutedText}" />
      <TextBlock Text="检测证据" FontWeight="SemiBold" Margin="0,14,0,7" />
      <TextBox Text="{Binding Basis, Mode=OneWay}" Style="{StaticResource EvidenceBox}" AutomationProperties.Name="检测证据，可选择并复制" />
      <TextBlock Text="可能原因" FontWeight="SemiBold" Margin="0,16,0,5" />
      <TextBlock Text="{Binding PossibleCause}" Style="{StaticResource MutedText}" />
      <Expander Header="分步核对与人工处理" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="4,8,0,0">
          <TextBlock Text="如何确认" FontWeight="SemiBold" Margin="0,0,0,5" /><TextBlock Text="{Binding Guide.Confirmation}" Style="{StaticResource MutedText}" />
          <StackPanel Visibility="{Binding Guide.HasCommands, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
            <TextBlock Text="只读诊断命令（复制后自行确认，不会自动执行）" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox Text="{Binding Guide.CommandsText, Mode=OneWay}" Style="{StaticResource EvidenceBox}" AutomationProperties.Name="只读诊断命令，可选择复制" />
            <Button Content="复制只读诊断命令" Command="{Binding DataContext.CopyDiagnosticCommandsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
          <TextBlock Text="人工处理步骤" FontWeight="SemiBold" Margin="0,15,0,5" /><TextBlock Text="{Binding Guide.StepsText}" Style="{StaticResource MutedText}" />
          <TextBlock Text="操作风险" FontWeight="SemiBold" Margin="0,15,0,5" /><TextBlock Text="{Binding Guide.Risk}" Style="{StaticResource MutedText}" />
          <TextBlock Text="如何恢复" FontWeight="SemiBold" Margin="0,15,0,5" /><TextBlock Text="{Binding Guide.Recovery}" Style="{StaticResource MutedText}" />
          <TextBlock Text="修复后验证" FontWeight="SemiBold" Margin="0,15,0,5" /><TextBlock Text="{Binding Guide.Retest}" Style="{StaticResource MutedText}" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="FindingCard">
    <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}">
      <StackPanel><WrapPanel><TextBlock Text="{Binding ModuleName}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,12,0" /><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" /></WrapPanel>
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6" />
        <TextBlock Text="{Binding Observed}" /><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FindingDetails}" />
        <WrapPanel Margin="0,16,0,0"><Button Content="定位相关工具" Command="{Binding DataContext.LocateFindingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,10,6" /><Button Content="重新检测此模块" Command="{Binding DataContext.RecheckFindingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" /></WrapPanel>
      </StackPanel>
    </Border>
  </DataTemplate>
  <DataTemplate x:Key="HistoryFindingCard">
    <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}">
      <StackPanel><WrapPanel><TextBlock Text="{Binding ModuleName}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,12,0" /><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" /></WrapPanel>
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6" />
        <TextBlock Text="{Binding Observed}" /><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FindingDetails}" />
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
