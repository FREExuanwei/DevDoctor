<Window x:Class="DevDoctor.App.ConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DevDoctor.Core;assembly=DevDoctor.Core" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="580" Height="480" MinWidth="360" MinHeight="260" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="5" CornerRadius="0" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="{DynamicResource CardPadding}" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource SurfaceBrush}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18"><TextBlock Text="DEVDOCTOR / 本地数据" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Message" TextWrapping="Wrap" LineHeight="24"/></ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="{x:Static ui:UiText.Cancel}" IsCancel="True" Margin="0,0,12,0" MinWidth="90"/><Button Content="{x:Static ui:UiText.ConfirmContinue}" Style="{StaticResource PrimaryButton}" Click="ConfirmClick" MinWidth="100"/></StackPanel>
    </Grid>
  </Border>
</Window>
