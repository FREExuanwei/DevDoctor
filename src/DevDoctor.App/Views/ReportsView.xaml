<UserControl x:Class="DevDoctor.App.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel DataContext="{Binding Reports}">
    <Border Style="{StaticResource HeroCard}" Margin="{DynamicResource RowSpacing}"><Grid><Path Style="{StaticResource HeroDecoration}"/><StackPanel>
      <TextBlock Text="报告与备份 / 记录、分享与保管" Style="{StaticResource Eyebrow}"/><TextBlock Text="你的证据，留在你的手中。" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="导出可离线阅读的报告，或保存完整本地备份。无需账号，不上传数据。" Style="{StaticResource MutedText}" Margin="0,10,0,12"/>
      <TextBlock Text="{Binding SelectionText}"/>
    </StackPanel></Grid></Border>
    <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}"><StackPanel>
      <TextBlock Text="导出诊断报告" Style="{StaticResource SectionTitle}"/><TextBlock Text="在“历史管理”选中记录。所有导出均再次脱敏；HTML 无脚本和外部资源。" Style="{StaticResource MutedText}" Margin="0,8,0,15"/>
      <WrapPanel><Button Content="单次诊断 · JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,12,10"/><Button Content="单次诊断 · HTML" Command="{Binding ExportHtmlCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,10"/><Button Content="历史对比 · JSON" Command="{Binding ExportDiffJsonCommand}" Margin="0,0,12,10"/><Button Content="历史对比 · HTML" Command="{Binding ExportDiffHtmlCommand}" Margin="0,0,0,10"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}"><StackPanel>
      <TextBlock Text="完整备份" Style="{StaticResource SectionTitle}"/><TextBlock Text="包含一致性 SQLite 历史快照、用户设置、主题与界面偏好、本地范围标识和校验信息。\n完整备份用于本机数据恢复；请像保管个人文件一样妥善保管。" Style="{StaticResource MutedText}" Margin="0,8,0,15"/>
      <Button Content="创建本地备份 ZIP…" Command="{Binding BackupCommand}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}"><StackPanel>
      <TextBlock Text="验证与恢复" Style="{StaticResource SectionTitle}"/><TextBlock Text="先选择备份并验证内容、格式和 SHA-256，再查看覆盖范围。确认恢复前会建立恢复点；中断后下次启动优先回退。" Style="{StaticResource MutedText}" Margin="0,8,0,15"/>
      <Button Content="选择并校验备份…" Command="{Binding ValidateCommand}" HorizontalAlignment="Left" Margin="0,0,0,15"/>
      <TextBox Text="{Binding PreviewText, Mode=OneWay}" Style="{StaticResource EvidenceBox}" MaxHeight="320" AutomationProperties.Name="备份验证和覆盖范围"/>
      <Button Content="恢复此备份…" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,15,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"/><TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/></StackPanel></Border>
  </StackPanel>
</UserControl>
