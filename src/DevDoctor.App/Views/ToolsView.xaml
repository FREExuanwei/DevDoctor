<UserControl x:Class="DevDoctor.App.Views.ToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <WrapPanel Margin="0,0,0,12" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Tools|Advanced}"><StackPanel Margin="0,0,16,6"><TextBlock Text="按状态查找工具" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding ToolStatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ToolStatusFilter}" MinWidth="180" AutomationProperties.Name="工具状态筛选" /></StackPanel><CheckBox Content="优先显示异常工具" IsChecked="{Binding ProblemsFirst}" VerticalAlignment="Bottom" Margin="0,0,0,7" /></WrapPanel>
    <ItemsControl ItemsSource="{Binding FilteredToolModules}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Tools}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ToolCard}" Content="{Binding Name}" Margin="0,0,10,10" Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding FilteredAdvancedModules}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Advanced}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ToolCard}" Content="{Binding Name}" Margin="0,0,10,10" Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <ContentControl Content="{Binding SelectedModule}"><ContentControl.ContentTemplate><DataTemplate>
      <StackPanel>
        <Border Style="{StaticResource HeroCard}" Margin="{DynamicResource RowSpacing}">
          <Grid><Path Style="{StaticResource HeroDecoration}" Width="100" MaxHeight="65" VerticalAlignment="Top" Opacity="0.55" /><StackPanel><WrapPanel><TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" LineHeight="36" Margin="0,0,18,6" /><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" VerticalAlignment="Center" /></WrapPanel>
            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,14" /><TextBlock Text="{Binding VersionText}" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,9" />
            <TextBlock Text="受检路径" Style="{StaticResource MutedText}" Margin="0,0,0,5" /><TextBox Text="{Binding PathText, Mode=OneWay}" Style="{StaticResource EvidenceBox}" AutomationProperties.Name="受检可执行路径，可选择并复制" />
            <WrapPanel Margin="0,14,0,0"><Button Content="重新检测此模块" Command="{Binding DataContext.RecheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Margin="0,0,16,6" /><TextBlock Text="{Binding CheckedAtText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></WrapPanel>
          </StackPanel></Grid>
        </Border>
        <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolVisibility}, ConverterParameter=Not}" Margin="{DynamicResource RowSpacing}"><StackPanel><TextBlock Text="等待检测" Style="{StaticResource SectionTitle}" /><TextBlock Text="点击上方“重新检测此模块”或开始完整诊断，获取本机真实结果。" Style="{StaticResource MutedText}" /></StackPanel></Border>
        <TextBlock Text="检测条目与判断依据" Style="{StaticResource SectionTitle}" /><TextBlock Text="需要关注的条目默认展开。每个条目均区分观察结果、证据、可能原因和人工操作建议。" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
        <ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}" Padding="{DynamicResource DenseCardPadding}">
            <Expander IsExpanded="{Binding IsProblem, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" HorizontalContentAlignment="Stretch">
              <Expander.Header><StackPanel Margin="5,1,0,8"><WrapPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,12,4" /><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" /></WrapPanel><TextBlock Text="{Binding Observed}" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel></Expander.Header>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FindingDetails}" />
            </Expander>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </DataTemplate></ContentControl.ContentTemplate></ContentControl>
  </StackPanel>
</UserControl>
