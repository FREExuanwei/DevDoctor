<UserControl x:Class="DevDoctor.App.Views.SearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="搜索当前诊断结果" FontSize="27" FontWeight="SemiBold" />
    <TextBlock Text="检索已采集的工具、问题与项目证据。搜索内容始终脱敏；更新诊断后结果会同步刷新。" Style="{StaticResource MutedText}" Margin="0,8,0,20" />
    <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}" Padding="{DynamicResource DenseCardPadding}">
      <StackPanel>
        <TextBlock Text="关键词" Margin="0,0,0,6" />
        <TextBox x:Name="QueryInput" MaxLength="256" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=180}" AutomationProperties.Name="搜索当前结果关键词" AutomationProperties.AutomationId="CurrentSearchQuery" MinHeight="38" />
        <WrapPanel Margin="0,14,0,0">
          <StackPanel Margin="0,0,12,10"><TextBlock Text="检测状态" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding IssueStatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SearchStatusFilter}" MinWidth="165" AutomationProperties.Name="搜索检测状态筛选" /></StackPanel>
          <StackPanel Margin="0,0,12,10"><TextBlock Text="结果类别" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding SearchKindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SearchKindFilter}" MinWidth="165" AutomationProperties.Name="搜索结果类别筛选" /></StackPanel>
          <Button Content="清空搜索与筛选" Command="{Binding ClearSearchCommand}" VerticalAlignment="Bottom" Margin="0,0,0,10" />
        </WrapPanel>
        <TextBlock Text="{Binding SearchCaption}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding SearchResults}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}" Padding="{DynamicResource DenseCardPadding}">
          <StackPanel>
            <WrapPanel><TextBlock Text="{Binding KindText}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,6" /><TextBlock Text="{Binding StatusText}" Margin="0,0,12,6" /><TextBlock Text="{Binding ObjectName}" FontWeight="SemiBold" Margin="0,0,0,6" /></WrapPanel>
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
            <Expander Header="查看匹配证据" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0"><TextBox Text="{Binding Evidence, Mode=OneWay}" Style="{StaticResource EvidenceBox}" Margin="0,8,0,0" AutomationProperties.Name="搜索结果脱敏证据，可选择复制" /></Expander>
            <Button Content="打开对应结论 →" Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,14,0,0" AutomationProperties.Name="打开此搜索结果对应的结论" />
          </StackPanel>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasSearchResults, Converter={StaticResource BoolVisibility}}"><Button Content="上一页" Command="{Binding PreviousSearchPageCommand}" Margin="0,0,8,8" /><Button Content="下一页" Command="{Binding NextSearchPageCommand}" Margin="0,0,14,8" /><TextBlock Text="{Binding SearchCaption}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,0,8" /></WrapPanel>
  </StackPanel>
</UserControl>
