<UserControl x:Class="DevDoctor.App.Views.ProjectView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DevDoctor.Core;assembly=DevDoctor.Core">
  <StackPanel DataContext="{Binding Project}">
    <Border Style="{StaticResource HeroCard}" Margin="{DynamicResource RowSpacing}">
      <Grid><Path Style="{StaticResource HeroDecoration}" /><StackPanel>
        <TextBlock Text="项目诊断 / 配置与环境逐条核对" Style="{StaticResource Eyebrow}" />
        <TextBlock Text="{Binding ProjectName}" FontSize="27" FontWeight="SemiBold" LineHeight="38" />
        <TextBlock Text="只读识别项目配置，再实测本机工具。不执行 Wrapper、构建脚本或依赖安装。" Style="{StaticResource MutedText}" Margin="0,8,0,14" />
        <TextBox Text="{Binding PathText, Mode=OneWay}" Style="{StaticResource EvidenceBox}" AutomationProperties.Name="选定项目路径，可选择复制" />
        <WrapPanel Margin="0,16,0,8">
          <Button Content="选择项目目录" Command="{Binding ChooseFolderCommand}" Margin="0,0,10,8" />
          <Button Content="诊断此项目 / 重新检测" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" AutomationProperties.Name="诊断或重新检测选定项目" />
          <Button Content="取消项目诊断" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,8" />
          <Button Content="复制项目报告（脱敏）" Command="{Binding CopyCommand}" Margin="0,0,0,8" />
        </WrapPanel>
        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10" AutomationProperties.Name="项目诊断进行中，以阶段与计数显示实际进度" />
        <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
      </StackPanel></Grid>
    </Border>
    <Border Style="{StaticResource Card}" Margin="{DynamicResource RowSpacing}" Padding="{DynamicResource DenseCardPadding}">
      <StackPanel>
        <TextBlock Text="{Binding TypesText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="扫描范围与时间" FontWeight="SemiBold" Margin="0,12,0,6" />
        <TextBox Text="{Binding ScopeText, Mode=OneWay}" Style="{StaticResource EvidenceBox}" />
        <Expander Header="项目、配置文件与所需工具清单" Foreground="{DynamicResource TextBrush}" Margin="0,14,0,0" HorizontalContentAlignment="Stretch">
          <TextBox Text="{Binding ProjectsText, Mode=OneWay}" Style="{StaticResource EvidenceBox}" Margin="0,10,0,0" AutomationProperties.Name="项目与配置清单，可选择复制" />
        </Expander>
      </StackPanel>
    </Border>
    <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="声明与环境匹配" Style="{StaticResource SectionTitle}" />
      <TextBlock Text="已确认满足仅针对该条声明。动态值、条件、外部继承和未验证工具链会保留未知或风险；不代表构建结果。" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
      <WrapPanel Margin="0,0,0,12">
        <ComboBox ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" MinWidth="140" Margin="0,0,16,8" AutomationProperties.Name="按项目类型筛选" />
        <CheckBox Content="仅显示问题、风险与无法判断" IsChecked="{Binding OnlyProblems}" VerticalAlignment="Center" Margin="0,0,0,8" />
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate><DataTemplate>
          <Button Style="{StaticResource ToolCard}" HorizontalContentAlignment="Stretch" Margin="0,0,0,9" Padding="{DynamicResource DenseCardPadding}"
                  Command="{Binding DataContext.SelectMatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Click="MatchClick">
            <StackPanel><WrapPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="12,0,0,5" /></WrapPanel>
              <TextBlock Text="{Binding Observed}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
              <TextBlock Text="查看原始声明、实测结果与判断依据  →" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" />
            </StackPanel>
          </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel Margin="0,10,0,20"><Button Content="{x:Static ui:UiText.PreviousPage}" Command="{Binding PreviousPageCommand}" Margin="0,0,8,6" /><Button Content="{x:Static ui:UiText.NextPage}" Command="{Binding NextPageCommand}" Margin="0,0,14,6" /><TextBlock Text="{Binding PageText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,0,6" /></WrapPanel>
      <ContentControl x:Name="Details" Content="{Binding SelectedMatch}">
        <ContentControl.ContentTemplate><DataTemplate>
          <Border Style="{StaticResource Card}" Padding="{DynamicResource DenseCardPadding}">
            <StackPanel>
              <TextBlock Text="匹配详情与证据" Style="{StaticResource SectionTitle}" />
              <WrapPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusTemplate}" /><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,6" /></WrapPanel>
              <TextBlock Text="项目声明" FontWeight="SemiBold" Margin="0,15,0,7" /><TextBox Text="{Binding Declaration, Mode=OneWay}" Style="{StaticResource EvidenceBox}" />
              <TextBlock Text="配置文件与原始证据" FontWeight="SemiBold" Margin="0,15,0,7" /><TextBox Text="{Binding Source, Mode=OneWay}" Style="{StaticResource EvidenceBox}" AutomationProperties.Name="项目配置证据，可选择复制" />
              <TextBlock Text="环境观察与判断依据" FontWeight="SemiBold" Margin="0,15,0,7" /><TextBlock Text="{Binding Observed}" Margin="0,0,0,7" /><TextBox Text="{Binding Reason, Mode=OneWay}" Style="{StaticResource EvidenceBox}" />
              <TextBlock Text="人工处理建议" FontWeight="SemiBold" Margin="0,15,0,7" /><TextBlock Text="{Binding Suggestions}" Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
        </DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
    </StackPanel>
  </StackPanel>
</UserControl>
