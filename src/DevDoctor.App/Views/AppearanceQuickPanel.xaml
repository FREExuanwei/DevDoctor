<UserControl x:Class="DevDoctor.App.Views.AppearanceQuickPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DevDoctor.Core;assembly=DevDoctor.Core"
             KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained"
             Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI,Segoe UI" FontSize="13">
  <UserControl.Resources>
    <Style x:Key="QuickChoice" TargetType="RadioButton" BasedOn="{StaticResource NavButton}">
      <Setter Property="Padding" Value="10,9" /><Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" Background="{DynamicResource RaisedBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AccentBackground}" /><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="18" ClipToBounds="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseAppearancePanelCommand}" Style="{StaticResource LinkButton}" MinWidth="30" Padding="6,0" AutomationProperties.Name="关闭快捷外观面板" ToolTip="关闭（Esc）" />
          <StackPanel><TextBlock Text="让工作区更合心意" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding QuickAppearanceSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" /></StackPanel>
        </DockPanel>
        <TextBlock Text="{x:Static ui:UiText.ThemePalette}" FontWeight="SemiBold" Margin="0,15,0,9" />
        <ItemsControl ItemsSource="{Binding ThemePreviews}" AutomationProperties.Name="六套快捷主题">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Style="{StaticResource ThemePreviewCard}" Margin="0,0,7,8" Padding="7" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.SelectThemePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}"
                    AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Description}" ToolTip="{Binding Description}">
              <StackPanel>
                <Border Background="{Binding Window}" CornerRadius="{Binding PreviewRadius}" Height="48" ClipToBounds="True">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{Binding Sidebar}" />
                    <Border Grid.Column="1" Background="{Binding Hero}" Margin="4" CornerRadius="{Binding PreviewRadius}">
                      <Grid ClipToBounds="True"><Path Data="{Binding Decoration}" Fill="{Binding DecorationBrush}" Stretch="UniformToFill" HorizontalAlignment="Right" Width="48" /><Border Background="{Binding Accent}" Width="22" Height="6" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" /></Grid>
                    </Border>
                  </Grid>
                </Border>
                <DockPanel Margin="0,6,0,0"><TextBlock DockPanel.Dock="Right" Text="✓" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" Margin="3,0,0,0" /><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI,Segoe UI" FontSize="11" LineHeight="15" MinHeight="30" VerticalAlignment="Center" /></DockPanel>
              </StackPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Static ui:UiText.DisplayMode}" FontWeight="SemiBold" Margin="0,9,0,9" />
        <UniformGrid Columns="3" KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton Style="{StaticResource QuickChoice}" Content="{x:Static ui:UiText.Light}" GroupName="QuickMode" IsChecked="{Binding AppearanceMode, Converter={StaticResource ChoiceSelected}, ConverterParameter=Light, Mode=TwoWay}" Command="{Binding SelectAppearanceModeCommand}" CommandParameter="Light" AutomationProperties.Name="快捷浅色模式" />
          <RadioButton Style="{StaticResource QuickChoice}" Content="{x:Static ui:UiText.Dark}" GroupName="QuickMode" IsChecked="{Binding AppearanceMode, Converter={StaticResource ChoiceSelected}, ConverterParameter=Dark, Mode=TwoWay}" Command="{Binding SelectAppearanceModeCommand}" CommandParameter="Dark" AutomationProperties.Name="快捷深色模式" />
          <RadioButton Style="{StaticResource QuickChoice}" Content="{x:Static ui:UiText.SystemMode}" GroupName="QuickMode" IsChecked="{Binding AppearanceMode, Converter={StaticResource ChoiceSelected}, ConverterParameter=System, Mode=TwoWay}" Command="{Binding SelectAppearanceModeCommand}" CommandParameter="System" AutomationProperties.Name="快捷跟随系统模式" />
        </UniformGrid>
        <TextBlock Text="{x:Static ui:UiText.InterfaceStyle}" FontWeight="SemiBold" Margin="0,18,0,9" />
        <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton Style="{StaticResource QuickChoice}" GroupName="QuickStyle" IsChecked="{Binding InterfaceStyle, Converter={StaticResource ChoiceSelected}, ConverterParameter=FluentProfessional, Mode=TwoWay}" Command="{Binding SelectInterfaceStyleCommand}" CommandParameter="FluentProfessional" AutomationProperties.Name="{x:Static ui:UiText.ProfessionalQuickName}" Margin="0,0,0,6"><StackPanel><TextBlock Text="{x:Static ui:UiText.ProfessionalStyle}" /><TextBlock Text="{x:Static ui:UiText.ProfessionalDescription}" TextWrapping="Wrap" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" /></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource QuickChoice}" GroupName="QuickStyle" IsChecked="{Binding InterfaceStyle, Converter={StaticResource ChoiceSelected}, ConverterParameter=SoftCards, Mode=TwoWay}" Command="{Binding SelectInterfaceStyleCommand}" CommandParameter="SoftCards" AutomationProperties.Name="{x:Static ui:UiText.SoftQuickName}" Margin="0,0,0,6"><StackPanel><TextBlock Text="{x:Static ui:UiText.SoftStyle}" /><TextBlock Text="{x:Static ui:UiText.SoftDescription}" TextWrapping="Wrap" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" /></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource QuickChoice}" GroupName="QuickStyle" IsChecked="{Binding InterfaceStyle, Converter={StaticResource ChoiceSelected}, ConverterParameter=CompactPro, Mode=TwoWay}" Command="{Binding SelectInterfaceStyleCommand}" CommandParameter="CompactPro" AutomationProperties.Name="{x:Static ui:UiText.CompactQuickName}" Margin="0"><StackPanel><TextBlock Text="{x:Static ui:UiText.CompactStyle}" /><TextBlock Text="{x:Static ui:UiText.CompactDescription}" TextWrapping="Wrap" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" /></StackPanel></RadioButton>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,10" />
        <TextBlock Text="{Binding AppearanceMessage}" FontSize="11" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
        <Button Content="更多外观设置与缩放  →" Command="{Binding OpenAppearanceSettingsCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,5,0,0" AutomationProperties.Name="更多外观设置与缩放" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
